# Copiar a .env y completar.

# PostgreSQL local (ver docker-compose.yml)
DATABASE_URL="postgresql://nextmedia:nextmedia_local@localhost:5432/nextplanning"

# Auth.js / NextAuth (generar: openssl rand -base64 32)
AUTH_SECRET="cambiar-por-secreto-largo"
AUTH_URL="http://localhost:3000"

# URL pública de la app (para links en emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OpenAI (obtener en https://platform.openai.com/api-keys)
OPENAI_API_KEY="sk-..."
# Generación de imágenes: activar solo si la cuenta tiene acceso a DALL-E
# OPENAI_IMAGE_ENABLED="true"
# OPENAI_IMAGE_MODEL="gpt-image-1"   # o gpt-image-2-2026-04-21 (sin input_fidelity). Alternativas: dall-e-2, dall-e-3

# Resend (emails transaccionales — https://resend.com)
RESEND_API_KEY="re_..."
EMAIL_FROM="NextPlanning <noreply@tudominio.com>"

# WhatsApp de alertas para el equipo NextMedia (opcional)
ADMIN_NOTIFY_WHATSAPP="whatsapp:+54911..."

# UploadThing (upload de fotos — https://uploadthing.com)
UPLOADTHING_TOKEN="..."

# Twilio (WhatsApp Business — https://twilio.com)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Mercado Pago (pagos integrados — https://mercadopago.com.ar/developers)
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."

# Cron last-minute alerts (opcional — header Authorization: Bearer <secret>)
CRON_SECRET="generar-secreto-largo"

# Seed bootstrap (producción / Render). Obligatorios para `npm run db:seed`.
# SEED_RESET=true borra TODA la base y la recrea — usar solo en el primer deploy o reset consciente.
SEED_ADMIN_EMAIL="admin@tudominio.com"
SEED_ADMIN_PASSWORD="cambiar-por-password-largo"
SEED_RESET="false"
