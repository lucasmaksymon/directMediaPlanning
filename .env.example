# Copiar a .env y completar. Neon: https://console.neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js / NextAuth (generar: openssl rand -base64 32)
AUTH_SECRET="cambiar-por-secreto-largo"
AUTH_URL="http://localhost:3000"

# URL pública de la app (para links en emails)
NEXT_PUBLIC_APP_URL="https://tudominio.com"

# OpenAI (obtener en https://platform.openai.com/api-keys)
OPENAI_API_KEY="sk-..."

# Resend (emails transaccionales — https://resend.com)
RESEND_API_KEY="re_..."
EMAIL_FROM="Direct Planning <noreply@tudominio.com>"

# UploadThing (upload de fotos — https://uploadthing.com)
UPLOADTHING_TOKEN="..."

# Twilio (WhatsApp Business — https://twilio.com)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
