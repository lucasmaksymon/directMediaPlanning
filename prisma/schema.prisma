// NextPlanning — inventario OOH con portales para Medios, Anunciantes y Agencias

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  advertiser
  provider
  admin
  agency
}

enum InventoryFormat {
  digital_ooh
  static_ooh
  digital_package
}

enum PriceModel {
  fixed_list
  negotiable
  package
}

enum InventoryStatus {
  draft
  published
  paused
}

enum BookingGranularity {
  day
  week
}

enum SlotState {
  available
  reserved_pending
  reserved_confirmed
  blocked
}

enum ReservationStatus {
  draft
  pending_provider
  rejected
  accepted
  payment_pending
  confirmed
  cancelled
}

enum PriceType {
  direct
  agency
}

enum CampaignStatus {
  draft
  active
  completed
  cancelled
}

enum PaymentStatus {
  pending
  approved
  rejected
  refunded
}

enum PoPStatus {
  pending
  submitted
  verified
  rejected
}

enum PublicationOrderStatus {
  draft
  sent
  in_progress
  completed
  cancelled
}

enum ScreenPlatform {
  android
  web
  tizen
  other
}

enum DealType {
  open
  pmp
  programmatic_guaranteed
}

enum OrganizationPlan {
  freemium
  pro
  enterprise
}

model PlatformSettings {
  id               String   @id @default("default")
  platformFeeRate  Decimal  @default(0.06) @db.Decimal(5, 4)
  freemiumMaxScreens Int    @default(10)
  updatedAt        DateTime @updatedAt
}

model Organization {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  plan         OrganizationPlan @default(freemium)
  maxScreens   Int              @default(10)
  countryCode  String           @default("AR")
  currency     String           @default("ARS")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  providers ProviderProfile[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  advertiserProfile AdvertiserProfile?
  providerProfile   ProviderProfile?
  agencyProfile     AgencyProfile?
  reservations      Reservation[]      @relation("AdvertiserReservations")
  agencyMemberships AgencyClient[]     @relation("AgencyClients")
  campaigns         Campaign[]
  creativeAssets    CreativeAsset[]
  erpClients        ErpClient[]
}

model AdvertiserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalName String?
  taxId     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Proveedor interno (socio de NextMedia). Sin userId = sin acceso a la plataforma.
model ProviderProfile {
  id             String        @id @default(cuid())
  userId         String?       @unique
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  companyName    String
  taxId          String?
  phone          String?
  description    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  inventoryUnits InventoryUnit[]
  circuits       Circuit[]
  screens        Screen[]
  playlists      Playlist[]
  erpVendors     ErpVendor[]
}

model InventoryUnit {
  id                       String              @id @default(cuid())
  providerId               String
  provider                 ProviderProfile     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name                     String
  format                   InventoryFormat
  locationLabel            String
  latitude                 Float?
  longitude                Float?
  basePriceAmount          Decimal             @db.Decimal(14, 2)
  currency                 String              @default("ARS")
  priceModel               PriceModel
  minimalBookingGranularity BookingGranularity @default(week)
  status                   InventoryStatus     @default(draft)
  description              String?
  imageUrls                String[]            @default([])
  metadata                 Json?

  // Precios diferenciales: directo al anunciante y precio preferencial para agencias
  agencyPriceAmount        Decimal?            @db.Decimal(14, 2)

  // Instant Book
  instantBookEnabled       Boolean             @default(false)
  instantBookMinDays       Int                 @default(1)
  instantBookMaxAmount     Decimal?            @db.Decimal(14, 2)

  // Last Minute
  lastMinuteEnabled        Boolean             @default(false)
  lastMinuteDiscountPercent Int                @default(20)
  lastMinuteWindowDays     Int                 @default(7)

  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  availability       AvailabilityBlock[]
  reservations       Reservation[]
  circuits           CircuitUnit[]
  screen             Screen?
  audienceReports    AudienceReport[]
  programmaticDeals  ProgrammaticDeal[]
  slotAvailabilities SlotAvailability[]
}

model AvailabilityBlock {
  id         String    @id @default(cuid())
  unitId     String
  unit       InventoryUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  endsAt     DateTime
  state      SlotState @default(available)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([unitId, startsAt, endsAt])
}

model Campaign {
  id           String         @id @default(cuid())
  advertiserId String
  advertiser   User           @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  name         String
  status       CampaignStatus @default(draft)
  budget       Decimal?       @db.Decimal(14, 2)
  startsAt     DateTime?
  endsAt       DateTime?
  metadata     Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  reservations      Reservation[]
  creatives         CreativeAsset[]
  publicationOrders PublicationOrder[]

  @@index([advertiserId])
}

model CreativeAsset {
  id           String    @id @default(cuid())
  advertiserId String
  advertiser   User      @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  campaignId   String?
  campaign     Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  name         String
  fileUrl      String
  mimeType     String?
  width        Int?
  height       Int?
  createdAt    DateTime  @default(now())

  @@index([advertiserId])
  @@index([campaignId])
}

model Reservation {
  id               String              @id @default(cuid())
  inventoryUnitId  String
  inventoryUnit    InventoryUnit       @relation(fields: [inventoryUnitId], references: [id], onDelete: Cascade)
  circuitId        String?
  circuit          Circuit?            @relation(fields: [circuitId], references: [id], onDelete: SetNull)
  campaignId       String?
  campaign         Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  advertiserId     String
  advertiser       User                @relation("AdvertiserReservations", fields: [advertiserId], references: [id], onDelete: Cascade)
  startsAt         DateTime
  endsAt           DateTime
  status           ReservationStatus   @default(pending_provider)
  agreedAmount     Decimal?            @db.Decimal(14, 2)
  platformFeeRate  Decimal?            @db.Decimal(5, 4)
  platformFeeAmount Decimal?           @db.Decimal(14, 2)
  priceType        PriceType           @default(direct)
  agencyId         String?
  agency           AgencyProfile?      @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  commissionAmount Decimal?            @db.Decimal(14, 2)
  providerNote     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  payment           Payment?
  proofOfPlay       ProofOfPlay?
  publicationOrder  PublicationOrder?

  @@index([advertiserId])
  @@index([inventoryUnitId, status])
  @@index([campaignId])
  @@index([circuitId])
}

model Payment {
  id                      String        @id @default(cuid())
  reservationId           String        @unique
  reservation               Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  amount                  Decimal       @db.Decimal(14, 2)
  platformFee             Decimal       @db.Decimal(14, 2)
  providerAmount          Decimal       @db.Decimal(14, 2)
  currency                String        @default("ARS")
  status                  PaymentStatus @default(pending)
  mercadoPagoPreferenceId String?
  mercadoPagoPaymentId    String?
  paidAt                  DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
}

model ProofOfPlay {
  id            String    @id @default(cuid())
  reservationId String    @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  fileUrl       String?
  notes         String?
  status        PoPStatus @default(pending)
  verifiedAt    DateTime?
  submittedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model PublicationOrder {
  id                 String                 @id @default(cuid())
  reservationId      String                 @unique
  reservation        Reservation            @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  campaignId         String?
  campaign           Campaign?              @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  creativeAssetIds   String[]               @default([])
  status             PublicationOrderStatus @default(draft)
  instructions       String?
  sentAt             DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
}

model Screen {
  id              String         @id @default(cuid())
  providerId      String
  provider        ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  inventoryUnitId String?        @unique
  inventoryUnit   InventoryUnit? @relation(fields: [inventoryUnitId], references: [id], onDelete: SetNull)
  name            String
  deviceKey       String         @unique
  platform        ScreenPlatform @default(web)
  lastHeartbeat   DateTime?
  isOnline        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  playlists Playlist[]
  playLogs  PlayLog[]

  @@index([providerId])
}

model Playlist {
  id          String          @id @default(cuid())
  providerId  String
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  screenId    String?
  screen      Screen?         @relation(fields: [screenId], references: [id], onDelete: SetNull)
  name        String
  version     Int             @default(1)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  items PlaylistItem[]

  @@index([providerId])
  @@index([screenId])
}

model PlaylistItem {
  id          String   @id @default(cuid())
  playlistId  String
  playlist    Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  creativeUrl String
  durationSec Int      @default(10)
  order       Int      @default(0)
  startsAt    DateTime?
  endsAt      DateTime?

  @@index([playlistId])
}

model PlayLog {
  id             String   @id @default(cuid())
  screenId       String
  screen         Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  creativeUrl    String
  playlistItemId String?
  playedAt       DateTime @default(now())
  durationSec    Int?

  @@index([screenId, playedAt])
}

model AudienceReport {
  id              String        @id @default(cuid())
  inventoryUnitId String
  inventoryUnit   InventoryUnit @relation(fields: [inventoryUnitId], references: [id], onDelete: Cascade)
  provider        String
  impressions     Int
  periodStart     DateTime
  periodEnd       DateTime
  metadata        Json?
  createdAt       DateTime      @default(now())

  @@index([inventoryUnitId, periodStart])
}

model ProgrammaticDeal {
  id              String        @id @default(cuid())
  inventoryUnitId String
  inventoryUnit   InventoryUnit @relation(fields: [inventoryUnitId], references: [id], onDelete: Cascade)
  dealType        DealType      @default(open)
  floorPrice      Decimal       @db.Decimal(14, 2)
  currency        String        @default("ARS")
  isActive        Boolean       @default(true)
  openRtbUnitId   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([inventoryUnitId, isActive])
}

model SlotAvailability {
  id        String        @id @default(cuid())
  unitId    String
  unit      InventoryUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  slotStart DateTime
  slotEnd   DateTime
  state     SlotState     @default(available)

  @@index([unitId, slotStart, slotEnd])
}

// Circuitos OOH — agrupamiento de unidades para venta en conjunto
model Circuit {
  id          String          @id @default(cuid())
  providerId  String
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  totalPrice  Decimal?        @db.Decimal(14, 2)
  isPublished Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  units        CircuitUnit[]
  reservations Reservation[]
}

model CircuitUnit {
  id        String        @id @default(cuid())
  circuitId String
  circuit   Circuit       @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  unitId    String
  unit      InventoryUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  order     Int           @default(0)

  @@unique([circuitId, unitId])
}

// Agencia — gestiona múltiples anunciantes
model AgencyProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName        String
  taxId              String?
  phone              String?
  website            String?
  description        String?
  /// Porcentaje de comisión que cobra la agencia (0-100). Ej: 15 = 15%
  commissionPct      Decimal  @default(15) @db.Decimal(5, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  clients      AgencyClient[]
  reservations Reservation[]
}

model AgencyClient {
  id               String        @id @default(cuid())
  agencyId         String
  agency           AgencyProfile @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  advertiserId     String
  advertiser       User          @relation("AgencyClients", fields: [advertiserId], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now())

  @@unique([agencyId, advertiserId])
}

// ---------------------------------------------------------------------------
// ERP interno (espejo de ADMINISTRACION). No mezclar con Reservation/Payment.
// Estados numéricos se conservan: maestros 0/1, órdenes 0=borrador 1=emitida 4=facturada.
// ---------------------------------------------------------------------------

model ErpCompany {
  id          String   @id @default(cuid())
  name        String
  currency    String   @default("ARS")
  paymentDays Int      @default(30)
  estado      Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clients     ErpClient[]
}

model ErpClient {
  id              String     @id @default(cuid())
  name            String
  companyId       String
  company         ErpCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)
  executiveUserId String?
  executive       User?      @relation(fields: [executiveUserId], references: [id], onDelete: SetNull)
  taxId           String?
  address         String?
  contact         String?
  email           String?
  phone           String?
  costRate        Decimal    @default(0) @db.Decimal(8, 4)
  agencyFee       Decimal    @default(0) @db.Decimal(8, 4)
  taxCondition    Int        @default(0)
  estado          Int        @default(1)
  industry        String?
  legalName       String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  saleOrders      ErpSaleOrder[]
  saleInvoices    ErpSaleInvoice[]
  saleReceipts    ErpSaleReceipt[]

  @@index([companyId])
  @@index([name])
}

model ErpVendor {
  id                   String           @id @default(cuid())
  kind                 Int              @default(0)
  name                 String
  taxId                String?
  address              String?
  contact              String?
  email                String?
  phone                String?
  cbu                  String?
  taxCondition         Int              @default(0)
  estado               Int              @default(1)
  paymentDays          Int              @default(30)
  nextmediaProviderId  String?
  nextmediaProvider    ProviderProfile? @relation(fields: [nextmediaProviderId], references: [id], onDelete: SetNull)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  purchaseOrders       ErpPurchaseOrder[]
  productionOrders     ErpProductionOrder[]
  purchaseInvoices     ErpPurchaseInvoice[]
  purchaseReceipts     ErpPurchaseReceipt[]
  paymentOrders        ErpPaymentOrder[]

  @@index([kind, name])
}

model ErpProvince {
  id        String    @id @default(cuid())
  name      String
  estado    Int       @default(1)
  createdAt DateTime  @default(now())
  cities    ErpCity[]
}

model ErpCity {
  id         String      @id @default(cuid())
  provinceId String
  province   ErpProvince @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  name       String
  estado     Int         @default(1)
  createdAt  DateTime    @default(now())

  @@index([provinceId])
}

model ErpCurrency {
  id        String   @id @default(cuid())
  code      String
  name      String
  rate      Decimal  @default(1) @db.Decimal(14, 6)
  estado    Int      @default(1)
  createdAt DateTime @default(now())
}

/// Soporte / producto de GESTIÓN (CPM, MUPIS, Pantalla LED…).
model ErpElement {
  id        String   @id @default(cuid())
  name      String
  estado    Int      @default(1)
  createdAt DateTime @default(now())
}

model ErpSaleOrder {
  id            String   @id @default(cuid())
  clientId      String
  client        ErpClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  issuedAt      DateTime
  month         Int
  year          Int
  number        String
  net           Decimal  @db.Decimal(14, 2)
  vat           Decimal  @db.Decimal(14, 2)
  amount        Decimal  @db.Decimal(14, 2)
  estado        Int      @default(1)
  cashPayment   Boolean  @default(false)
  attachmentExt String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  items            ErpCampaignItem[]
  gestionLines     ErpGestionLine[]
  purchaseOrders   ErpPurchaseOrder[]
  productionOrders ErpProductionOrder[]
  invoices         ErpSaleInvoice[]

  @@index([clientId, year, month])
  @@index([number])
}

/// Ítem de campaña (hoja GESTIÓN: elemento, plaza, cantidad, período).
model ErpCampaignItem {
  id          String       @id @default(cuid())
  saleOrderId String
  saleOrder   ErpSaleOrder @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)
  element     String
  location    String?
  quantity    Decimal      @default(0) @db.Decimal(12, 2)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime     @default(now())

  @@index([saleOrderId])
}

/// Fila de la hoja GESTIÓN: ítem + FC compra + producción + FC venta.
model ErpGestionLine {
  id                   String              @id @default(cuid())
  saleOrderId          String
  saleOrder            ErpSaleOrder        @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)
  sort                 Int                 @default(0)
  element              String?
  location             String?
  quantity             Decimal             @default(0) @db.Decimal(12, 2)
  startsAt             DateTime?
  endsAt               DateTime?
  purchaseInvoiceId    String?
  purchaseInvoice      ErpPurchaseInvoice? @relation("GestionPurchase", fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)
  productionInvoiceId  String?
  productionInvoice    ErpPurchaseInvoice? @relation("GestionProduction", fields: [productionInvoiceId], references: [id], onDelete: SetNull)
  saleInvoiceId        String?
  saleInvoice          ErpSaleInvoice?     @relation(fields: [saleInvoiceId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())

  @@index([saleOrderId, sort])
}

model ErpPurchaseOrder {
  id            String       @id @default(cuid())
  saleOrderId   String
  saleOrder     ErpSaleOrder @relation(fields: [saleOrderId], references: [id], onDelete: Restrict)
  vendorId      String
  vendor        ErpVendor    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  issuedAt      DateTime
  number        String
  net           Decimal      @db.Decimal(14, 2)
  vat           Decimal      @db.Decimal(14, 2)
  amount        Decimal      @db.Decimal(14, 2)
  estado        Int          @default(1)
  cashPayment   Boolean      @default(false)
  attachmentExt String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  invoiceLinks  ErpPurchaseInvoiceOrder[]

  @@index([saleOrderId])
  @@index([vendorId])
}

model ErpProductionOrder {
  id            String       @id @default(cuid())
  saleOrderId   String
  saleOrder     ErpSaleOrder @relation(fields: [saleOrderId], references: [id], onDelete: Restrict)
  vendorId      String
  vendor        ErpVendor    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  issuedAt      DateTime
  number        String
  net           Decimal      @db.Decimal(14, 2)
  vat           Decimal      @db.Decimal(14, 2)
  amount        Decimal      @db.Decimal(14, 2)
  estado        Int          @default(1)
  cashPayment   Boolean      @default(false)
  attachmentExt String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  invoiceLinks  ErpPurchaseInvoiceOrder[] @relation("ProductionInvoiceOrders")

  @@index([saleOrderId])
  @@index([vendorId])
}

model ErpSaleInvoice {
  id            String       @id @default(cuid())
  clientId      String
  client        ErpClient    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  saleOrderId   String
  saleOrder     ErpSaleOrder @relation(fields: [saleOrderId], references: [id], onDelete: Restrict)
  issuedAt      DateTime
  dueAt         DateTime
  docType       String
  pos           Int
  number        Int
  amount        Decimal      @db.Decimal(14, 2)
  vat           Decimal      @db.Decimal(14, 2)
  legalName     String?
  detail        String?
  collected     Decimal      @default(0) @db.Decimal(14, 2)
  receiptRef    String?
  retVat        Decimal      @default(0) @db.Decimal(14, 2)
  retSuss       Decimal      @default(0) @db.Decimal(14, 2)
  retGan        Decimal      @default(0) @db.Decimal(14, 2)
  retIibb       Decimal      @default(0) @db.Decimal(14, 2)
  echeq         Decimal      @default(0) @db.Decimal(14, 2)
  bank          Decimal      @default(0) @db.Decimal(14, 2)
  collectStatus Int          @default(0)
  attachmentExt String?
  attachmentUrl String?
  createdAt     DateTime     @default(now())
  receiptLinks  ErpSaleReceiptInvoice[]
  gestionLines  ErpGestionLine[]

  @@index([saleOrderId])
  @@index([clientId])
}

model ErpPurchaseInvoice {
  id            String   @id @default(cuid())
  vendorId      String
  vendor        ErpVendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  issuedAt      DateTime
  dueAt         DateTime
  docType       String
  pos           Int
  number        Int
  amount        Decimal  @db.Decimal(14, 2)
  vat           Decimal  @db.Decimal(14, 2)
  vatWithholding Decimal @default(0) @db.Decimal(14, 2)
  iibbCaba      Decimal  @default(0) @db.Decimal(14, 2)
  iibbBsAs      Decimal  @default(0) @db.Decimal(14, 2)
  internalTax   Decimal  @default(0) @db.Decimal(14, 2)
  nonTaxable    Decimal  @default(0) @db.Decimal(14, 2)
  isVatPurchase Boolean  @default(false)
  isCreditNote  Boolean  @default(false)
  commission    Decimal  @default(0) @db.Decimal(14, 2)
  diegoFee      Decimal  @default(0) @db.Decimal(14, 2)
  payStatus     Int      @default(0)
  attachmentExt String?
  attachmentUrl String?
  createdAt     DateTime @default(now())
  orderLinks    ErpPurchaseInvoiceOrder[]
  receiptLinks  ErpPurchaseReceiptInvoice[]
  paymentLinks  ErpPaymentOrderInvoice[]
  gestionPurchases   ErpGestionLine[] @relation("GestionPurchase")
  gestionProductions ErpGestionLine[] @relation("GestionProduction")

  @@index([vendorId])
}

model ErpPurchaseInvoiceOrder {
  id                 String              @id @default(cuid())
  invoiceId          String
  invoice            ErpPurchaseInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  purchaseOrderId    String?
  purchaseOrder      ErpPurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  productionOrderId  String?
  productionOrder    ErpProductionOrder? @relation("ProductionInvoiceOrders", fields: [productionOrderId], references: [id], onDelete: SetNull)
  vendorKind         Int
  createdAt          DateTime            @default(now())
}

model ErpSaleReceipt {
  id            String   @id @default(cuid())
  clientId      String
  client        ErpClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  issuedAt      DateTime
  number        Int
  amount        Decimal  @db.Decimal(14, 2)
  balance       Decimal  @db.Decimal(14, 2)
  attachmentExt String?
  createdAt     DateTime @default(now())
  invoices      ErpSaleReceiptInvoice[]
  payments      ErpTreasuryPayment[]

  @@index([clientId])
}

model ErpSaleReceiptInvoice {
  id        String         @id @default(cuid())
  receiptId String
  receipt   ErpSaleReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   ErpSaleInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([receiptId, invoiceId])
}

model ErpPurchaseReceipt {
  id            String    @id @default(cuid())
  vendorId      String
  vendor        ErpVendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  issuedAt      DateTime
  number        Int
  amount        Decimal   @db.Decimal(14, 2)
  balance       Decimal   @db.Decimal(14, 2)
  attachmentExt String?
  createdAt     DateTime  @default(now())
  invoices      ErpPurchaseReceiptInvoice[]
  payments      ErpTreasuryPayment[]

  @@index([vendorId])
}

model ErpPurchaseReceiptInvoice {
  id        String             @id @default(cuid())
  receiptId String
  receipt   ErpPurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   ErpPurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([receiptId, invoiceId])
}

model ErpPaymentOrder {
  id        String    @id @default(cuid())
  vendorId  String
  vendor    ErpVendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  issuedAt  DateTime
  number    Int
  amount    Decimal   @db.Decimal(14, 2)
  balance   Decimal   @db.Decimal(14, 2)
  notes     String?
  createdAt DateTime  @default(now())
  invoices  ErpPaymentOrderInvoice[]
  treasury  ErpTreasuryPayment[]

  @@index([vendorId])
}

model ErpPaymentOrderInvoice {
  id             String             @id @default(cuid())
  paymentOrderId String
  paymentOrder   ErpPaymentOrder    @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)
  invoiceId      String
  invoice        ErpPurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentOrderId, invoiceId])
}

/// pagos del legado. tipoPago=1 es cheque.
model ErpTreasuryPayment {
  id                 String              @id @default(cuid())
  saleReceiptId      String?
  saleReceipt        ErpSaleReceipt?     @relation(fields: [saleReceiptId], references: [id], onDelete: SetNull)
  purchaseReceiptId  String?
  purchaseReceipt    ErpPurchaseReceipt? @relation(fields: [purchaseReceiptId], references: [id], onDelete: SetNull)
  paymentOrderId     String?
  paymentOrder       ErpPaymentOrder?    @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)
  paymentKind        Int
  number             String?
  notes              String?
  issuedAt           DateTime?
  paidAt             DateTime?
  checkOrder         Int                 @default(0)
  checkType          Int                 @default(0)
  checkMode          Int                 @default(0)
  amount             Decimal             @db.Decimal(14, 2)
  estado             Int                 @default(0)
  createdAt          DateTime            @default(now())

  @@index([saleReceiptId])
  @@index([purchaseReceiptId])
  @@index([paymentOrderId])
  @@index([paymentKind, estado])
}

model ErpExpense {
  id           String   @id @default(cuid())
  month        Int
  year         Int
  fixed        Decimal  @default(0) @db.Decimal(14, 2)
  bank         Decimal  @default(0) @db.Decimal(14, 2)
  vat          Decimal  @default(0) @db.Decimal(14, 2)
  commissions  Decimal  @default(0) @db.Decimal(14, 2)
  createdAt    DateTime @default(now())

  @@unique([month, year])
}
