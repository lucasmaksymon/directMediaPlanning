// NextPlanning — inventario OOH con portales para Medios, Anunciantes y Agencias

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  advertiser
  provider
  admin
  agency
}

enum InventoryFormat {
  digital_ooh
  static_ooh
  digital_package
}

enum PriceModel {
  fixed_list
  negotiable
  package
}

enum InventoryStatus {
  draft
  published
  paused
}

enum BookingGranularity {
  day
  week
}

enum SlotState {
  available
  reserved_pending
  reserved_confirmed
  blocked
}

enum ReservationStatus {
  draft
  pending_provider
  rejected
  accepted
  payment_pending
  confirmed
  cancelled
}

enum PriceType {
  direct
  agency
}

enum CampaignStatus {
  draft
  active
  completed
  cancelled
}

enum PaymentStatus {
  pending
  approved
  rejected
  refunded
}

enum PoPStatus {
  pending
  submitted
  verified
  rejected
}

enum PublicationOrderStatus {
  draft
  sent
  in_progress
  completed
  cancelled
}

enum ScreenPlatform {
  android
  web
  tizen
  other
}

enum DealType {
  open
  pmp
  programmatic_guaranteed
}

enum OrganizationPlan {
  freemium
  pro
  enterprise
}

model PlatformSettings {
  id               String   @id @default("default")
  platformFeeRate  Decimal  @default(0.06) @db.Decimal(5, 4)
  freemiumMaxScreens Int    @default(10)
  updatedAt        DateTime @updatedAt
}

model Organization {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  plan         OrganizationPlan @default(freemium)
  maxScreens   Int              @default(10)
  countryCode  String           @default("AR")
  currency     String           @default("ARS")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  providers ProviderProfile[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  advertiserProfile AdvertiserProfile?
  providerProfile   ProviderProfile?
  agencyProfile     AgencyProfile?
  reservations      Reservation[]      @relation("AdvertiserReservations")
  agencyMemberships AgencyClient[]     @relation("AgencyClients")
  campaigns         Campaign[]
  creativeAssets    CreativeAsset[]
}

model AdvertiserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalName String?
  taxId     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Proveedor interno (socio de NextMedia). Sin userId = sin acceso a la plataforma.
model ProviderProfile {
  id             String        @id @default(cuid())
  userId         String?       @unique
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  companyName    String
  taxId          String?
  phone          String?
  description    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  inventoryUnits InventoryUnit[]
  circuits       Circuit[]
  screens        Screen[]
  playlists      Playlist[]
}

model InventoryUnit {
  id                       String              @id @default(cuid())
  providerId               String
  provider                 ProviderProfile     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name                     String
  format                   InventoryFormat
  locationLabel            String
  latitude                 Float?
  longitude                Float?
  basePriceAmount          Decimal             @db.Decimal(14, 2)
  currency                 String              @default("ARS")
  priceModel               PriceModel
  minimalBookingGranularity BookingGranularity @default(week)
  status                   InventoryStatus     @default(draft)
  description              String?
  imageUrls                String[]            @default([])
  metadata                 Json?

  // Precios diferenciales: directo al anunciante y precio preferencial para agencias
  agencyPriceAmount        Decimal?            @db.Decimal(14, 2)

  // Instant Book
  instantBookEnabled       Boolean             @default(false)
  instantBookMinDays       Int                 @default(1)
  instantBookMaxAmount     Decimal?            @db.Decimal(14, 2)

  // Last Minute
  lastMinuteEnabled        Boolean             @default(false)
  lastMinuteDiscountPercent Int                @default(20)
  lastMinuteWindowDays     Int                 @default(7)

  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  availability       AvailabilityBlock[]
  reservations       Reservation[]
  circuits           CircuitUnit[]
  screen             Screen?
  audienceReports    AudienceReport[]
  programmaticDeals  ProgrammaticDeal[]
  slotAvailabilities SlotAvailability[]
}

model AvailabilityBlock {
  id         String    @id @default(cuid())
  unitId     String
  unit       InventoryUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  endsAt     DateTime
  state      SlotState @default(available)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([unitId, startsAt, endsAt])
}

model Campaign {
  id           String         @id @default(cuid())
  advertiserId String
  advertiser   User           @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  name         String
  status       CampaignStatus @default(draft)
  budget       Decimal?       @db.Decimal(14, 2)
  startsAt     DateTime?
  endsAt       DateTime?
  metadata     Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  reservations      Reservation[]
  creatives         CreativeAsset[]
  publicationOrders PublicationOrder[]

  @@index([advertiserId])
}

model CreativeAsset {
  id           String    @id @default(cuid())
  advertiserId String
  advertiser   User      @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  campaignId   String?
  campaign     Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  name         String
  fileUrl      String
  mimeType     String?
  width        Int?
  height       Int?
  createdAt    DateTime  @default(now())

  @@index([advertiserId])
  @@index([campaignId])
}

model Reservation {
  id               String              @id @default(cuid())
  inventoryUnitId  String
  inventoryUnit    InventoryUnit       @relation(fields: [inventoryUnitId], references: [id], onDelete: Cascade)
  circuitId        String?
  circuit          Circuit?            @relation(fields: [circuitId], references: [id], onDelete: SetNull)
  campaignId       String?
  campaign         Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  advertiserId     String
  advertiser       User                @relation("AdvertiserReservations", fields: [advertiserId], references: [id], onDelete: Cascade)
  startsAt         DateTime
  endsAt           DateTime
  status           ReservationStatus   @default(pending_provider)
  agreedAmount     Decimal?            @db.Decimal(14, 2)
  platformFeeRate  Decimal?            @db.Decimal(5, 4)
  platformFeeAmount Decimal?           @db.Decimal(14, 2)
  priceType        PriceType           @default(direct)
  agencyId         String?
  agency           AgencyProfile?      @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  commissionAmount Decimal?            @db.Decimal(14, 2)
  providerNote     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  payment           Payment?
  proofOfPlay       ProofOfPlay?
  publicationOrder  PublicationOrder?

  @@index([advertiserId])
  @@index([inventoryUnitId, status])
  @@index([campaignId])
  @@index([circuitId])
}

model Payment {
  id                      String        @id @default(cuid())
  reservationId           String        @unique
  reservation               Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  amount                  Decimal       @db.Decimal(14, 2)
  platformFee             Decimal       @db.Decimal(14, 2)
  providerAmount          Decimal       @db.Decimal(14, 2)
  currency                String        @default("ARS")
  status                  PaymentStatus @default(pending)
  mercadoPagoPreferenceId String?
  mercadoPagoPaymentId    String?
  paidAt                  DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
}

model ProofOfPlay {
  id            String    @id @default(cuid())
  reservationId String    @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  fileUrl       String?
  notes         String?
  status        PoPStatus @default(pending)
  verifiedAt    DateTime?
  submittedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model PublicationOrder {
  id                 String                 @id @default(cuid())
  reservationId      String                 @unique
  reservation        Reservation            @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  campaignId         String?
  campaign           Campaign?              @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  creativeAssetIds   String[]               @default([])
  status             PublicationOrderStatus @default(draft)
  instructions       String?
  sentAt             DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
}

model Screen {
  id              String         @id @default(cuid())
  providerId      String
  provider        ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  inventoryUnitId String?        @unique
  inventoryUnit   InventoryUnit? @relation(fields: [inventoryUnitId], references: [id], onDelete: SetNull)
  name            String
  deviceKey       String         @unique
  platform        ScreenPlatform @default(web)
  lastHeartbeat   DateTime?
  isOnline        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  playlists Playlist[]
  playLogs  PlayLog[]

  @@index([providerId])
}

model Playlist {
  id          String          @id @default(cuid())
  providerId  String
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  screenId    String?
  screen      Screen?         @relation(fields: [screenId], references: [id], onDelete: SetNull)
  name        String
  version     Int             @default(1)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  items PlaylistItem[]

  @@index([providerId])
  @@index([screenId])
}

model PlaylistItem {
  id          String   @id @default(cuid())
  playlistId  String
  playlist    Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  creativeUrl String
  durationSec Int      @default(10)
  order       Int      @default(0)
  startsAt    DateTime?
  endsAt      DateTime?

  @@index([playlistId])
}

model PlayLog {
  id             String   @id @default(cuid())
  screenId       String
  screen         Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  creativeUrl    String
  playlistItemId String?
  playedAt       DateTime @default(now())
  durationSec    Int?

  @@index([screenId, playedAt])
}

model AudienceReport {
  id              String        @id @default(cuid())
  inventoryUnitId String
  inventoryUnit   InventoryUnit @relation(fields: [inventoryUnitId], references: [id], onDelete: Cascade)
  provider        String
  impressions     Int
  periodStart     DateTime
  periodEnd       DateTime
  metadata        Json?
  createdAt       DateTime      @default(now())

  @@index([inventoryUnitId, periodStart])
}

model ProgrammaticDeal {
  id              String        @id @default(cuid())
  inventoryUnitId String
  inventoryUnit   InventoryUnit @relation(fields: [inventoryUnitId], references: [id], onDelete: Cascade)
  dealType        DealType      @default(open)
  floorPrice      Decimal       @db.Decimal(14, 2)
  currency        String        @default("ARS")
  isActive        Boolean       @default(true)
  openRtbUnitId   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([inventoryUnitId, isActive])
}

model SlotAvailability {
  id        String        @id @default(cuid())
  unitId    String
  unit      InventoryUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  slotStart DateTime
  slotEnd   DateTime
  state     SlotState     @default(available)

  @@index([unitId, slotStart, slotEnd])
}

// Circuitos OOH — agrupamiento de unidades para venta en conjunto
model Circuit {
  id          String          @id @default(cuid())
  providerId  String
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  totalPrice  Decimal?        @db.Decimal(14, 2)
  isPublished Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  units        CircuitUnit[]
  reservations Reservation[]
}

model CircuitUnit {
  id        String        @id @default(cuid())
  circuitId String
  circuit   Circuit       @relation(fields: [circuitId], references: [id], onDelete: Cascade)
  unitId    String
  unit      InventoryUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  order     Int           @default(0)

  @@unique([circuitId, unitId])
}

// Agencia — gestiona múltiples anunciantes
model AgencyProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName        String
  taxId              String?
  phone              String?
  website            String?
  description        String?
  /// Porcentaje de comisión que cobra la agencia (0-100). Ej: 15 = 15%
  commissionPct      Decimal  @default(15) @db.Decimal(5, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  clients      AgencyClient[]
  reservations Reservation[]
}

model AgencyClient {
  id               String        @id @default(cuid())
  agencyId         String
  agency           AgencyProfile @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  advertiserId     String
  advertiser       User          @relation("AgencyClients", fields: [advertiserId], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now())

  @@unique([agencyId, advertiserId])
}
